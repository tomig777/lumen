{
  "name": "personal-os",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:backup": "node --test tests/backup.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:brain": "node --test tests/brainGraph.test.mjs",
    "test:daily": "node --test tests/daily.test.mjs tests/workoutSession.test.mjs",
    "test:offline": "node --test tests/offlineShell.test.mjs",
    "test:viewport": "node --test tests/mobileViewport.test.mjs tests/screenLayout.test.mjs tests/layoutDiagnostic.test.mjs",
    "test:icons": "node --test tests/icons.test.mjs",
    "test:updates": "node --test tests/offlineUpdates.test.mjs tests/appRelease.test.mjs"
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
