{
  "name": "personal-os",
  "private": true,
  "version": "0.1.24",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && node scripts/generate-service-worker.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:backup": "node --test tests/backup.test.mjs",
    "test:storage": "node --test tests/storage.test.mjs",
    "test:brain": "node --test tests/brainGraph.test.mjs",
    "test:daily": "node --test tests/daily.test.mjs tests/workoutSession.test.mjs",
    "test:offline": "node --test tests/offlineShell.test.mjs",
    "test:viewport": "node --test tests/mobileViewport.test.mjs tests/screenLayout.test.mjs tests/layoutDiagnostic.test.mjs",
    "test:icons": "node --test tests/icons.test.mjs",
    "test:welcome": "node --test tests/welcome.test.mjs tests/welcomeGlass.test.mjs tests/launchTheme.test.mjs",
    "test:theme": "node --test tests/theme.test.mjs",
    "test:settings": "node --test tests/settings.test.mjs",
    "test:glass": "node --test tests/glassControls.test.mjs",
    "test:home": "node --test tests/home.test.mjs tests/homeCharacter.test.mjs tests/characterPointer.test.mjs tests/homeBaseline.test.mjs tests/taskEditor.test.mjs tests/taskDrawer.test.mjs",
    "test:home-baseline": "node scripts/build-home-baseline.mjs",
    "test:updates": "node --test tests/offlineUpdates.test.mjs tests/appRelease.test.mjs"
  },
  "dependencies": {
    "@bryllim/workout-guide": "^1.0.0",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.2.5",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
